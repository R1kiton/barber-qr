// Esquema de BarberQR. Refleja la base que ya existe en Supabase.
//
// OJO: tres cosas del SQL original NO se pueden expresar aqui y viven solo en
// prisma/migrations/0_init/migration.sql:
//   - la restriccion `exclude using gist` que impide citas solapadas,
//   - los CHECK (slug, duracion, precio, estado, end_min > start_min),
//   - la columna generada `appointments.code`.
// Por eso nunca se debe usar `prisma db push` ni `migrate reset` en esta base:
// reconstruyen desde este archivo y se llevarian por delante esas garantias.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Shop {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug      String   @unique
  name      String
  address   String   @default("")
  phone     String   @default("")
  pinHash   String   @map("pin_hash")
  ownerEmail String? @unique @map("owner_email")
  passwordHash String? @map("password_hash")
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
  openTime  String   @map("open_time")
  closeTime String   @map("close_time")
  workDays  Int[]    @map("work_days") @db.SmallInt
  weeklyHours Json? @map("weekly_hours")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  services     Service[]
  barbers      Barber[]
  appointments Appointment[]
  sessions AdminSession[]

  @@map("shops")
}

model AdminSession {
  tokenHash String @id @map("token_hash")
  shopId String @map("shop_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  @@index([shopId])
  @@index([expiresAt])
  @@map("admin_sessions")
}

model PendingRegistration {
  tokenHash String @id @map("token_hash")
  email String
  codeHash String @map("code_hash")
  payload Json
  attempts Int @default(0)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  @@index([expiresAt])
  @@map("pending_registrations")
}

model AuthRateLimit {
  key String @id
  count Int @default(1)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  @@index([expiresAt])
  @@map("auth_rate_limits")
}

model Service {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shopId      String   @map("shop_id") @db.Uuid
  name        String
  durationMin Int      @map("duration_min")
  price       Decimal  @default(0) @db.Decimal(10, 2)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  shop         Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([shopId], map: "services_shop_idx")
  @@map("services")
}

model Barber {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shopId    String   @map("shop_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  shop         Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([shopId], map: "barbers_shop_idx")
  @@map("barbers")
}

model Appointment {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Columna generada en Postgres a partir del id. Es de solo lectura:
  /// nunca se envia en un insert ni en un update.
  code String @default(dbgenerated())

  shopId        String    @map("shop_id") @db.Uuid
  serviceId     String?   @map("service_id") @db.Uuid
  barberId      String?   @map("barber_id") @db.Uuid
  serviceName   String    @map("service_name")
  price         Decimal   @default(0) @db.Decimal(10, 2)
  date          DateTime  @db.Date
  time          String
  startMin      Int       @map("start_min")
  endMin        Int       @map("end_min")
  customerName  String    @map("customer_name")
  customerPhone String    @map("customer_phone")
  status        String    @default("confirmada")
  checkedInAt   DateTime? @map("checked_in_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  shop    Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  barber  Barber?  @relation(fields: [barberId], references: [id], onDelete: SetNull)

  @@index([shopId, date], map: "appointments_shop_date_idx")
  @@index([shopId, code], map: "appointments_shop_code_idx")
  @@map("appointments")
}
